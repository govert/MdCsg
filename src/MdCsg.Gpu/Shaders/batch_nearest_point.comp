#version 450

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
    uint pointCount;
    uint bvhNodeCount;
    uint faceCount;
} pc;

struct BvhNode {
    float boundsMinX, boundsMinY, boundsMinZ, boundsMaxX;
    float boundsMaxY, boundsMaxZ;
    int leftOrStart, right;
    int primitiveCount, pad0, pad1, pad2;
};

layout(std430, binding = 0) readonly buffer BvhNodes { BvhNode nodes[]; };
layout(std430, binding = 1) readonly buffer FaceIndices { int faceIndices[]; };
layout(std430, binding = 2) readonly buffer TriVerts { vec4 triVerts[]; };
layout(std430, binding = 3) readonly buffer QueryPoints { vec4 queryPoints[]; };
layout(std430, binding = 4) buffer OutputDistances { float outDistances[]; };
layout(std430, binding = 5) buffer OutputFaceIndices { int outFaceIndices[]; };

float aabbDistanceSq(vec3 p, vec3 bmin, vec3 bmax) {
    vec3 d = max(bmin - p, vec3(0.0)) + max(p - bmax, vec3(0.0));
    return dot(d, d);
}

// Returns nearest point on triangle and distance squared
float pointTriangleDistanceSq(vec3 p, vec3 a, vec3 b, vec3 c) {
    vec3 ab = b - a, ac = c - a, ap = p - a;
    float d1 = dot(ab, ap), d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) return dot(ap, ap);

    vec3 bp = p - b;
    float d3 = dot(ab, bp), d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) return dot(bp, bp);

    float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
        float v = d1 / (d1 - d3);
        vec3 diff = p - (a + v * ab);
        return dot(diff, diff);
    }

    vec3 cp = p - c;
    float d5 = dot(ab, cp), d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) return dot(cp, cp);

    float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
        float w = d2 / (d2 - d6);
        vec3 diff = p - (a + w * ac);
        return dot(diff, diff);
    }

    float va = d3 * d6 - d5 * d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
        float w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        vec3 diff = p - (b + w * (c - b));
        return dot(diff, diff);
    }

    float denom = 1.0 / (va + vb + vc);
    float v = vb * denom;
    float w = vc * denom;
    vec3 diff = p - (a + ab * v + ac * w);
    return dot(diff, diff);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.pointCount) return;

    vec3 p = queryPoints[idx].xyz;

    float minDistSq = 1e30;
    int nearestFace = -1;

    int stack[32];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        BvhNode node = nodes[nodeIdx];
        vec3 bmin = vec3(node.boundsMinX, node.boundsMinY, node.boundsMinZ);
        vec3 bmax = vec3(node.boundsMaxX, node.boundsMaxY, node.boundsMaxZ);

        if (aabbDistanceSq(p, bmin, bmax) >= minDistSq) continue;

        if (node.primitiveCount > 0) {
            for (int i = 0; i < node.primitiveCount; i++) {
                int fi = faceIndices[node.leftOrStart + i];
                vec3 v0 = triVerts[fi * 3 + 0].xyz;
                vec3 v1 = triVerts[fi * 3 + 1].xyz;
                vec3 v2 = triVerts[fi * 3 + 2].xyz;
                float dSq = pointTriangleDistanceSq(p, v0, v1, v2);
                if (dSq < minDistSq) {
                    minDistSq = dSq;
                    nearestFace = fi;
                }
            }
        } else {
            if (node.leftOrStart >= 0 && node.leftOrStart < int(pc.bvhNodeCount))
                stack[stackPtr++] = node.leftOrStart;
            if (node.right >= 0 && node.right < int(pc.bvhNodeCount))
                stack[stackPtr++] = node.right;
        }
    }

    outDistances[idx] = sqrt(minDistSq);
    outFaceIndices[idx] = nearestFace;
}
